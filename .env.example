# Local development values only. Replace them outside local environments.
VERA_ENVIRONMENT=development
VERA_LOG_LEVEL=INFO
VERA_DATABASE_URL=postgresql+asyncpg://vera:vera@postgres:5432/vera
VERA_API_HOST=0.0.0.0
VERA_API_PORT=8000
VERA_APP_NAME=Vera
VERA_MAX_REPORT_SIZE_BYTES=10485760
# Optional provider enrichment. Normal CI detection does not require tokens.
VERA_GITLAB_TOKEN=
VERA_GITLAB_API_URL=https://gitlab.com/api/v4
VERA_GITHUB_TOKEN=
VERA_GITHUB_API_URL=https://api.github.com
VERA_CI_PROVIDER_OVERRIDE=
VERA_PROVIDER_API_TIMEOUT=5
# Optional JSON override for the documented flaky-v1 scoring policy. Leave unset to use defaults.
# VERA_STABILITY_POLICY={"minimum_observations":10,"stable_observations":20}
# Host port published by Docker Compose; change it when 8000 is already in use.
VERA_HOST_PORT=8000

POSTGRES_DB=vera
POSTGRES_USER=vera
POSTGRES_PASSWORD=vera
